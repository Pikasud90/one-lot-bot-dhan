* text=auto eol=lf

# Shell scripts MUST stay LF or they will not execute
*.sh        text eol=lf
*.bash      text eol=lf

# Windows scripts MUST be CRLF or cmd.exe mis-parses them
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary
*.png       binary
*.jpg       binary
*.pkl       binary
*.db        binary
