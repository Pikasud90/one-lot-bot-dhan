# ─────────────────────────────────────────────────────────────────────────────
#  Copy to `.env` and fill in — or paste the same values in the web app's
#  Settings tab, which writes this file for you (mode 0600). NEVER commit `.env`.
#
#  Get tokens from Dhan: https://web.dhan.co -> My Profile -> Access DhanHQ APIs
#  A web-generated access token is valid for 24 hours; regenerate daily.
#
#  FREE TIER (any token): profile, funds, holdings, positions, ledger, trade book.
#  PAID DATA API (Rs 499 + GST / month, on the ACCOUNT): live feed, option chain,
#  historical and intraday bars. Run `python -m onelot preflight` to see exactly
#  which tier your token reaches right now.
# ─────────────────────────────────────────────────────────────────────────────

DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Optional second token. The Data API entitlement lives on the account, so
# either token works for everything once the plan is active; this slot only
# lets you keep the paid one separate. When set, data endpoints use it.
DHAN_DATA_ACCESS_TOKEN=

# Shared secret the web app uses for every mutating call (ack a signal, run a
# backtest, save settings). Leave blank and the engine generates one per run
# into data/api_token.txt. Set it if you open the app from other devices.
ONELOT_API_TOKEN=

# Optional: alerts on your phone (SIGNAL, EXIT, CRITICAL). Both are needed; see the
# README section "Telegram: alerts on your phone".
#   TELEGRAM_BOT_TOKEN: the token @BotFather gives you after /newbot.
#   TELEGRAM_CHAT_ID:   your chat with the bot: send the bot a message, then read
#                       result[0].message.chat.id from https://api.telegram.org/bot<token>/getUpdates
# Leave them blank and alerts stay on the dashboard and the OS toast.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: override storage. Blank => SQLite at data/onelot.db (WAL mode).
DB_URL=

# Optional: override the config file path
ONELOT_CONFIG=config/config.yaml
